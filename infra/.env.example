# Copiar este archivo como infra/.env antes de iniciar MySQL.
# Son valores locales de ejemplo: reemplazarlos y no reutilizarlos fuera de desarrollo.
COMPOSE_PROJECT_NAME=comercio-flex
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=local_root_change_me
MYSQL_APP_USER=comercio_flex_app
MYSQL_APP_PASSWORD=local_app_change_me
MYSQL_MIGRATION_USER=comercio_flex_migration
MYSQL_MIGRATION_PASSWORD=local_migration_change_me
