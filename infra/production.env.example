# Perfil y URL pÃºblica. No guardar valores reales en Git.
SPRING_PROFILES_ACTIVE=prod
PORT=8080
PUBLIC_FRONTEND_BASE_URI=https://comercio.example.com
PUBLIC_BACKEND_BASE_URI=https://comercio.example.com
FRONTEND_ORIGINS=https://comercio.example.com
SESSION_COOKIE_SECURE=true

# Bootstrap de un solo uso para el primer administrador global.
# Habilitar sólo durante un deploy y retirar la contraseña después de validar el acceso.
SUPER_ADMIN_BOOTSTRAP_ENABLED=false
SUPER_ADMIN_BOOTSTRAP_EMAIL=
SUPER_ADMIN_BOOTSTRAP_PASSWORD=
SUPER_ADMIN_BOOTSTRAP_DISPLAY_NAME=

# Base de control: usuario exclusivo con permisos DML.
CONTROL_DB_URL=jdbc:mysql://mysql.example.internal:3306/comercio_flex_control
CONTROL_DB_USER=replace_control_app_user
CONTROL_DB_PASSWORD=replace_in_secret_manager

# Cada tenant usa un usuario diferente y sin acceso a las otras bases.
TENANT_A_DB_URL=jdbc:mysql://mysql.example.internal:3306/comercio_flex_tenant_a
TENANT_A_DB_USER=replace_tenant_a_app_user
TENANT_A_DB_PASSWORD=replace_in_secret_manager
TENANT_B_DB_URL=jdbc:mysql://mysql.example.internal:3306/comercio_flex_tenant_b
TENANT_B_DB_USER=replace_tenant_b_app_user
TENANT_B_DB_PASSWORD=replace_in_secret_manager

# Usuario DDL reservado al arranque/migraciones.
MIGRATION_DB_USER=replace_migration_user
MIGRATION_DB_PASSWORD=replace_in_secret_manager

# ImÃ¡genes privadas S3/R2.
MEDIA_S3_BUCKET=replace_bucket
MEDIA_S3_REGION=auto
MEDIA_S3_ENDPOINT=https://replace_account_id.r2.cloudflarestorage.com
MEDIA_S3_ACCESS_KEY=replace_in_secret_manager
MEDIA_S3_SECRET_KEY=replace_in_secret_manager
MEDIA_S3_PATH_STYLE=true

# Mercado Pago: comenzar en TEST; activar producciÃ³n despuÃ©s del checklist manual.
PAYMENTS_MERCADO_PAGO_ENABLED=false
PAYMENTS_CHECKOUT_PRO_ENABLED=true
PAYMENT_MODE=TEST
MP_TEST_ACCESS_TOKEN=replace_in_secret_manager
MP_TEST_SELLER_ACCOUNT_ID=replace_test_seller_id
MP_TEST_DEMO_TENANT_SLUG=tienda-a
MP_WEBHOOK_SECRET=replace_in_secret_manager
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_OAUTH_REDIRECT_URI=https://comercio.example.com/api/v1/integrations/mercado-pago/oauth/callback

# Clave AES-256 en Base64. Generar fuera del repositorio y conservar versiones anteriores al rotar.
PAYMENT_TOKEN_ACTIVE_KEY_ID=v1
PAYMENT_TOKEN_ENCRYPTION_KEY_V1=replace_in_secret_manager
