# Referencia para Render + Aiven. No guardar valores reales en Git.
SPRING_PROFILES_ACTIVE=prod
PORT=8080
PUBLIC_FRONTEND_BASE_URI=https://comercio.example.com
PUBLIC_BACKEND_BASE_URI=https://comercio.example.com
FRONTEND_ORIGINS=https://comercio.example.com
SESSION_COOKIE_SECURE=true

# Bootstrap de un solo uso para el primer administrador global.
# Habilitar sólo durante un deploy y retirar la contraseña después de validar el acceso.
SUPER_ADMIN_BOOTSTRAP_ENABLED=false
SUPER_ADMIN_BOOTSTRAP_EMAIL=
SUPER_ADMIN_BOOTSTRAP_PASSWORD=
SUPER_ADMIN_BOOTSTRAP_DISPLAY_NAME=

# Base de control. Este usuario runtime sólo necesita DML sobre comercio_flex_control.
CONTROL_DB_URL=jdbc:mysql://mysql-service.aivencloud.com:12345/comercio_flex_control?sslMode=REQUIRED
CONTROL_DB_USER=replace_control_runtime_user
CONTROL_DB_PASSWORD=replace_in_render_secret

# Aprovisionamiento dinámico database-per-tenant.
# El template debe conservar literalmente {database}.
TENANT_PROVISIONING_ENABLED=true
TENANT_DB_URL_TEMPLATE=jdbc:mysql://mysql-service.aivencloud.com:12345/{database}?sslMode=REQUIRED
TENANT_DATABASE_PREFIX=comercio_flex_tenant_
TENANT_DATABASE_USER_HOST=%

# Runtime tenant: sólo DML. Nunca usar avnadmin ni el usuario de control.
TENANT_SHARED_DB_USER=replace_tenant_runtime_user
TENANT_SHARED_DB_PASSWORD=replace_in_render_secret

# Flyway tenant/control: DDL sobre las bases administradas, sin CREATE DATABASE global.
MIGRATION_DB_USER=replace_migration_user
MIGRATION_DB_PASSWORD=replace_in_render_secret

# Provider MySQL: conexión separada con CREATE DATABASE y capacidad de otorgar permisos.
# En Aiven puede ser avnadmin si el plan no permite delegar esos privilegios; no reutilizarlo
# para tráfico runtime ni para CONTROL_DB_USER.
TENANT_PROVISIONING_DB_URL=jdbc:mysql://mysql-service.aivencloud.com:12345/defaultdb?sslMode=REQUIRED
TENANT_PROVISIONING_DB_USER=replace_provisioning_user
TENANT_PROVISIONING_DB_PASSWORD=replace_in_render_secret

# Compatibilidad legacy opcional. No agregar TENANT_C/TENANT_D para empresas nuevas.
# Si se usa una conexión estática, definir juntas URL, usuario y contraseña.
TENANT_A_DB_URL=
TENANT_A_DB_USER=
TENANT_A_DB_PASSWORD=
TENANT_B_DB_URL=
TENANT_B_DB_USER=
TENANT_B_DB_PASSWORD=

# Imágenes privadas S3/R2.
MEDIA_S3_BUCKET=replace_bucket
MEDIA_S3_REGION=auto
MEDIA_S3_ENDPOINT=https://replace_account_id.r2.cloudflarestorage.com
MEDIA_S3_ACCESS_KEY=replace_in_render_secret
MEDIA_S3_SECRET_KEY=replace_in_render_secret
MEDIA_S3_PATH_STYLE=true

# Mercado Pago: comenzar en TEST; activar producción después del checklist manual.
PAYMENTS_MERCADO_PAGO_ENABLED=false
PAYMENTS_CHECKOUT_PRO_ENABLED=true
PAYMENT_MODE=TEST
MP_TEST_ACCESS_TOKEN=replace_in_render_secret
MP_TEST_SELLER_ACCOUNT_ID=replace_test_seller_id
MP_TEST_DEMO_TENANT_SLUG=tienda-a
MP_WEBHOOK_SECRET=replace_in_render_secret
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_OAUTH_REDIRECT_URI=https://comercio.example.com/api/v1/integrations/mercado-pago/oauth/callback

# Clave AES-256 en Base64. Generar fuera del repositorio y conservar versiones anteriores al rotar.
PAYMENT_TOKEN_ACTIVE_KEY_ID=v1
PAYMENT_TOKEN_ENCRYPTION_KEY_V1=replace_in_render_secret
