# Referencia para el servicio STAGING en Easypanel.
# No guardar valores reales ni reutilizar credenciales de produccion.
SPRING_PROFILES_ACTIVE=staging
PORT=8080

PUBLIC_FRONTEND_BASE_URI=https://staging.comercioflex.com.ar
PUBLIC_BACKEND_BASE_URI=https://staging.comercioflex.com.ar
IDENTITY_PUBLIC_BASE_URI=https://staging.comercioflex.com.ar
FRONTEND_ORIGINS=https://staging.comercioflex.com.ar
SESSION_COOKIE_SECURE=true

# Staging debe permanecer aislado de produccion.
CONTROL_DB_URL=jdbc:mysql://mysql.internal:3306/comercio_flex_staging_control?sslMode=REQUIRED
CONTROL_DB_USER=replace_staging_control_runtime_user
CONTROL_DB_PASSWORD=<secret>

TENANT_PROVISIONING_ENABLED=true
TENANT_DB_URL_TEMPLATE=jdbc:mysql://mysql.internal:3306/{database}?sslMode=REQUIRED
TENANT_DATABASE_PREFIX=comercio_flex_staging_tenant_
TENANT_DATABASE_USER_HOST=%
TENANT_SHARED_DB_USER=replace_staging_tenant_runtime_user
TENANT_SHARED_DB_PASSWORD=<secret>
MIGRATION_DB_USER=replace_staging_migration_user
MIGRATION_DB_PASSWORD=<secret>
TENANT_PROVISIONING_DB_URL=jdbc:mysql://mysql.internal:3306/?sslMode=REQUIRED
TENANT_PROVISIONING_DB_USER=replace_staging_provisioning_user
TENANT_PROVISIONING_DB_PASSWORD=<secret>

# No enviar emails reales desde staging.
EMAIL_ENABLED=false

# Usar objetos/buckets exclusivos de staging.
MEDIA_STORAGE=s3
MEDIA_S3_BUCKET=replace_staging_bucket
MEDIA_S3_REGION=auto
MEDIA_S3_ENDPOINT=https://replace_account_id.r2.cloudflarestorage.com
MEDIA_S3_ACCESS_KEY=<secret>
MEDIA_S3_SECRET_KEY=<secret>
MEDIA_S3_PATH_STYLE=true

PAYMENT_RECEIPT_STORAGE=s3
PAYMENT_RECEIPT_S3_BUCKET=replace_staging_receipts_bucket
PAYMENT_RECEIPT_S3_REGION=auto
PAYMENT_RECEIPT_S3_ENDPOINT=https://replace_account_id.r2.cloudflarestorage.com
PAYMENT_RECEIPT_S3_ACCESS_KEY=<secret>
PAYMENT_RECEIPT_S3_SECRET_KEY=<secret>

# Nunca usar credenciales productivas de Mercado Pago en staging.
PAYMENTS_MERCADO_PAGO_ENABLED=false
PAYMENTS_CHECKOUT_PRO_ENABLED=true
PAYMENT_MODE=TEST
MP_TEST_ACCESS_TOKEN=<test-secret>
MP_TEST_SELLER_ACCOUNT_ID=replace_test_seller_id
MP_TEST_DEMO_TENANT_SLUG=demo
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_OAUTH_REDIRECT_URI=https://staging.comercioflex.com.ar/api/v1/integrations/mercado-pago/oauth/callback
MP_WEBHOOK_SECRET=<staging-secret>
MP_ORDERS_WEBHOOK_SECRET=<different-staging-secret>

PAYMENT_TOKEN_ACTIVE_KEY_ID=v1
PAYMENT_TOKEN_ENCRYPTION_KEY_V1=<staging-secret>

SUPER_ADMIN_BOOTSTRAP_ENABLED=false
SUPER_ADMIN_BOOTSTRAP_EMAIL=
SUPER_ADMIN_BOOTSTRAP_PASSWORD=
SUPER_ADMIN_BOOTSTRAP_DISPLAY_NAME=
